# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8081

# Build Configuration
# Set to true to analyze bundle size
ANALYZE=false

# Feature Flags
VITE_ENABLE_MATLAB_PLOTS=false
VITE_ENABLE_MATLAB_TOGGLE=false
VITE_ENABLE_HISTORY=true
VITE_MAX_HISTORY_ENTRIES=50


set to true to enable Wilcoxon.
VITE_ENABLE_WILCOXON=false

# turn if presentation
VITE_ENABLE_RESULT_CACHE=false
